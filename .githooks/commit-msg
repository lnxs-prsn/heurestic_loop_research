#!/bin/sh
# commit-msg hook — enforces specs/08 BP-10 (adapted from innovations/
# machine-enforced-laws kit). POSIX sh + grep. Activation is owner decision
# D-10:  git config core.hooksPath .githooks   (undo: --unset core.hooksPath)
# Keep the pattern below in lockstep with BP-10 (BP-19).

FIRST=$(head -n1 "$1")

# Pass id (P1.4), or an area; optional (scope); then ": <text>".
if printf '%s\n' "$FIRST" | grep -Eq '^(P[0-9]+\.[0-9]+[a-z]?|specs(/[0-9]{2})?|spec|docs|progress|BUILDLOG|HANDOFF|decisions|intake|scripts|build|fix|test|chore)(\([A-Za-z0-9_./, -]+\))?: .+'; then
    exit 0
fi
if printf '%s\n' "$FIRST" | grep -Eq '^(Merge |Revert )'; then
    exit 0
fi

echo "commit-msg: rejected — first line must look like one of:" >&2
echo "  P1.4: event logger (DM-13..16)   | specs/08: BP-15 decision ledger" >&2
echo "  progress: HANDOFF rewrite        | docs(manual): ...  | Merge/Revert ..." >&2
echo "(rules: specs/08 BP-10; bypass once with --no-verify)" >&2
exit 1
